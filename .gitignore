# ============================================================
# .gitignore para Träume des Blauen
# ============================================================

# ===== Android / Gradle =====
# Archivos generados por la compilación de Android
*.apk
*.aab
*.ap_
*.dex
*.class
.gradle/
build/
local.properties
captures/
.externalNativeBuild/
.cxx/

# ===== Keystores (NUNCA subir) =====
# Archivos de firma de aplicaciones Android
*.jks
*.keystore

# ===== IDE =====
# Carpetas y archivos generados por editores
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# ===== Sistema operativo =====
# Archivos generados por el sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# ===== Catálogo generado automáticamente =====
# Este archivo lo regenera el workflow de GitHub Actions
docs/catalog.json

# ===== Logs y temporales =====
# Archivos temporales o de depuración
*.log
*.tmp
*.bak
temp/
experimentales/
otros/
fallidos/

# ===== PowerShell =====
# Backups y temporales de scripts
*.ps1.bak

# ===== Scripts de automatización local =====
# Scripts que no forman parte del repositorio público
push.ps1

# ============================================================
# EXCEPCIONES (deben ir al final)
# ============================================================

# Los APKs de apps SÍ se suben (están dentro de apps/)
!apps/**/*.apk